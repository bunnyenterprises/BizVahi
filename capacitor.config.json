{
  "appId": "com.fintr.app",
  "appName": "Fintr",
  "webDir": "frontend/build",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "hostname": "fintr.app",
    "allowNavigation": [
      "*.fintr.in",
      "*.onrender.com",
      "*.vercel.app"
    ]
  },
  "android": {
    "buildOptions": {
      "keystorePath": "fintr.keystore",
      "keystoreAlias": "fintr"
    }
  },
  "ios": {
    "contentInset": "always"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#002FA7",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "Light",
      "backgroundColor": "#002FA7"
    }
  }
}
